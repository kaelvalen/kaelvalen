{
  "name": "portfolio",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "workers": "node scripts/build-workers.mjs",
    "dev": "node scripts/build-workers.mjs && next dev",
    "build": "node scripts/build-workers.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "budget": "node scripts/budget.mjs",
    "test:visual:update": "docker run --rm -v \"$PWD\":/w -w /w mcr.microsoft.com/playwright:v1.64.0-noble npx playwright test visual --update-snapshots"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "playwright-core": "1.64.0"
  }
}
